<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The database and photos form one logical data set. Keep both out of
             quota-limited cloud backup; users can use the ZIP export instead. -->
        <exclude domain="database" path="user_locations.db" />
        <exclude domain="database" path="user_locations.db-wal" />
        <exclude domain="database" path="user_locations.db-shm" />
        <exclude domain="database" path="user_locations.db-journal" />
        <exclude domain="external" path="Pictures" />
    </cloud-backup>
    <!-- An empty section enables the platform default: transfer all eligible
         app data, including Room files and getExternalFilesDir photos. -->
    <device-transfer />
</data-extraction-rules>
